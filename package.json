{
  "name": "ownmemory",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "description": "Local-first persistent memory for AI agents — SQLite, on-device embeddings, Cursor MCP",
  "bin": {
    "ownmemory-mcp": "./bin/ownmemory-mcp.mjs"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 47321",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 47321",
    "lint": "eslint",
    "mcp": "node bin/ownmemory-mcp.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "reembed": "tsx scripts/reembed.ts",
    "cursor:install": "bash connectors/cursor/scripts/install-local.sh",
    "embed-http": "tsx connectors/zikron-embed/src/run.ts",
    "test:embed-http": "node --import tsx --test connectors/zikron-embed/src/server.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
